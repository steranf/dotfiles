[user]
	name = YOUR_NAME
	email = YOUR_EMAIL

[core]
	editor = nvim
	autocrlf = input

[alias]
	st = status
	co = checkout
	br = branch -v
	lg = log --oneline --graph --decorate -n 20
	undo = reset --soft HEAD~1
	aliases = config --get-regexp alias

[pull]
	rebase = false

[push]
	autoSetupRemote = true

[init]
	defaultBranch = main

[color]
	ui = auto

[diff]
	tool = vimdiff

[merge]
	tool = vimdiff
